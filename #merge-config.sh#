#!/usr/bin/env bash

# Merge NGOL configuration with existing NixOS configuration

set -e

echo "🔧 Merging NGOL configuration with NixOS configuration"
echo "======================================================"
echo ""

# Check if running as root
if [[ $EUID -ne 0 ]]; then
cd    echo "❌ This script must be run as root"
    echo "Please run: sudo $0"
    exit 1
fi

# Backup files
CONFIG_FILE="/etc/nixos/configuration.nix"
BACKUP_FILE="/etc/nixos/configuration.nix.backup.20260208"
NGOL_DIR="/opt/ngol"

echo "📁 Current configuration: $CONFIG_FILE"
echo "📁 Backup file: $BACKUP_FILE"
echo "📁 NGOL directory: $NGOL_DIR"
echo ""

# Check if backup file exists
if [[ ! -f "$BACKUP_FILE" ]]; then
    echo "❌ Backup file not found: $BACKUP_FILE"
    echo "Looking for other backup files..."
    
    # Find any backup files
    BACKUP_FILES=($(find /etc/nixos -name "configuration.nix.backup*" -o -name "configuration.nix.bak*"))
    
    if [[ ${#BACKUP_FILES[@]} -eq 0 ]]; then
        echo "❌ No backup files found. Creating a backup of current configuration first."
        cp "$CONFIG_FILE" "$CONFIG_FILE.backup.$(date +%Y%m%d%H%M%S)"
        BACKUP_FILE="$CONFIG_FILE.backup.$(date +%Y%m%d%H%M%S)"
    else
        echo "Found backup files:"
        for i in "${!BACKUP_FILES[@]}"; do
            echo "  [$i] ${BACKUP_FILES[$i]}"
        done
        
        read -p "Select backup file number (default: 0): " backup_choice
        backup_choice=${backup_choice:-0}
        BACKUP_FILE="${BACKUP_FILES[$backup_choice]}"
    fi
fi

echo "✅ Using backup file: $BACKUP_FILE"
echo ""

# Check if NGOL directory exists
if [[ ! -d "$NGOL_DIR" ]]; then
    echo "⚠️  NGOL directory not found at $NGOL_DIR"
    read -p "Enter NGOL directory path (or leave empty to use current directory): " custom_ngol_dir
    
    if [[ -n "$custom_ngol_dir" ]]; then
        NGOL_DIR="$custom_ngol_dir"
    else
        NGOL_DIR="$(pwd)"
    fi
    
    if [[ ! -d "$NGOL_DIR" ]]; then
        echo "❌ NGOL directory not found: $NGOL_DIR"
        exit 1
    fi
fi

echo "✅ Using NGOL directory: $NGOL_DIR"
echo ""

# Analyze current configuration
echo "📊 Analyzing configurations..."
echo ""

# Extract current imports from backup
BACKUP_IMPORTS=$(grep -A 20 "^[[:space:]]*imports" "$BACKUP_FILE" | grep -E "\[|\./|\.\." | head -10)
CURRENT_IMPORTS=$(grep -A 20 "^[[:space:]]*imports" "$CONFIG_FILE" | grep -E "\[|\./|\.\." | head -10)

echo "📋 Backup file imports:"
echo "$BACKUP_IMPORTS"
echo ""
echo "📋 Current file imports:"
echo "$CURRENT_IMPORTS"
echo ""

# Create merged configuration
echo "🔄 Creating merged configuration..."
echo ""

# Create temporary merged file
MERGED_FILE="/tmp/configuration-merged.nix"

cat > "$MERGED_FILE" << 'EOF'
# Merged NixOS Configuration
# Generated on $(date)
# Original backup: $BACKUP_FILE
# NGOL directory: $NGOL_DIR

{ config, lib, pkgs, ... }:

let
  # Import NGOL flake
  ngol = builtins.fetchTarball "file://$NGOL_DIR";
in
{
EOF

# Extract non-imports section from backup
echo "📝 Extracting configuration from backup..."
grep -v "^[[:space:]]*imports" "$BACKUP_FILE" | \
  grep -v "^[[:space:]]*}" | \
  grep -v "^[[:space:]]*{[[:space:]]*$" >> "$MERGED_FILE"

# Add NGOL imports
cat >> "$MERGED_FILE" << 'EOF'

  # ============================================
  # NGO Logistics System Configuration
  # ============================================
  imports = [
    # Original imports from backup
EOF

# Add original imports
if [[ -n "$BACKUP_IMPORTS" ]]; then
    echo "$BACKUP_IMPORTS" | sed 's/^/    /' >> "$MERGED_FILE"
fi

cat >> "$MERGED_FILE" << 'EOF'
    
    # NGOL system module
    (import ngol).nixosModule
  ];

  # NGOL service configuration
  services.ngol = {
    enable = true;
    domain = "localhost";
    port = 5000;
    frontendPort = 5173;
    databasePath = "/var/lib/ngol/ngol.db";
    jwtSecretFile = "/etc/ngol/jwt-secret";
    googleMapsApiKeyFile = "/etc/ngol/google-maps-api-key";
  };

  # Enable flakes for NGOL
  nix.settings.experimental-features = [ "nix-command" "flakes" ];

  # Open necessary ports for NGOL
  networking.firewall.allowedTCPPorts = lib.mkIf config.networking.firewall.enable (
    config.networking.firewall.allowedTCPPorts ++ [ 5000 5173 ]
  );
}
EOF

echo "✅ Merged configuration created at: $MERGED_FILE"
echo ""

# Show diff
echo "📋 Changes to be applied:"
echo "------------------------"
diff -u "$CONFIG_FILE" "$MERGED_FILE" || true
echo ""

# Ask for confirmation
read -p "Apply merged configuration? (y/N): " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "❌ Merge cancelled."
    echo "You can review the merged configuration at: $MERGED_FILE"
    exit 0
fi

# Backup current config
echo "💾 Backing up current configuration..."
cp "$CONFIG_FILE" "$CONFIG_FILE.backup.$(date +%Y%m%d%H%M%S)"

# Apply merged config
echo "🔄 Applying merged configuration..."
cp "$MERGED_FILE" "$CONFIG_FILE"

echo "✅ Configuration merged successfully!"
echo ""
echo "📋 Next steps:"
echo "1. Review the merged configuration:"
echo "   sudo nano /etc/nixos/configuration.nix"
echo ""
echo "2. Build the system:"
echo "   sudo nixos-rebuild switch"
echo ""
echo "3. Start NGOL services:"
echo "   sudo systemctl start ngol-backend ngol-frontend"
echo "   sudo systemctl enable ngol-backend ngol-frontend"
echo ""
echo "4. Access NGOL:"
echo "   Frontend: http://localhost:5173"
echo "   Backend:  http://localhost:5000"
echo ""
echo "🔐 Default login: admin@example.org / password123"
