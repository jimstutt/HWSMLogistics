cabal-version:      3.0
name:               frontend
version:            0.1.0.0
synopsis:           Pure Haskell WASM frontend for HWSMLogistics
build-type:         Simple

executable frontend
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >= 4.14 && < 5
                  , text
                  , aeson
  default-language: Haskell2010
  default-extensions: OverloadedStrings
