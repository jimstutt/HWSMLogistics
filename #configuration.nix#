{ config, lib, pkgs, ... }:

let
  # Import our flake
  ngol = builtins.fetchTarball "https://github.com/your-org/ngol-logistics/archive/main.tar.gz";
  # Or use local path:
  # ngol = /path/to/NGOL-D;
in
{
  imports = [
    # Import our NixOS module
    (import "${ngol}").nixosModule
    
    # Include hardware configuration if available
    ./hardware-configuration.nix
  ];

  # Boot configuration
  boot = {
    loader = {
      systemd-boot.enable = true;
      efi.canTouchEfiVariables = true;
    };
    
    # Kernel parameters
    kernelParams = [ "console=ttyS0" ];
    
    # Clean /tmp on boot
    cleanTmpDir = true;
  };

  # Network configuration
  networking = {
    hostName = "ngol-server";
    domain = "example.com";
    
    # Use NetworkManager or systemd-networkd
    networkmanager.enable = true;
    
    # Firewall
    firewall = {
      enable = true;
      allowedTCPPorts = [ 22 80 443 ];
    };
  };

  # Timezone and locale
  time.timeZone = "Africa/Nairobi";
  i18n.defaultLocale = "en_US.UTF-8";

  # User accounts
  users.users = {
    # Admin user
    admin = {
      isNormalUser = true;
      extraGroups = [ "wheel" "ngol" ];
      openssh.authorizedKeys.keys = [
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... admin-key"
      ];
    };
    
    # NGOL system user (created by the module)
  };

  # System packages
  environment.systemPackages = with pkgs; [
    vim
    htop
    git
    curl
    wget
    tmux
    # Our NGOL packages
    (import ngol).packages.x86_64-linux.ngol-frontend
    (import ngol).packages.x86_64-linux.ngol-backend
  ];

  # NGOL service configuration
  services.ngol = {
    enable = true;
    domain = "ngol.your-domain.com";
    port = 5000;
    frontendPort = 5173;
    databasePath = "/var/lib/ngol/ngol.db";
    jwtSecretFile = "/etc/ngol/jwt-secret";
    googleMapsApiKeyFile = "/etc/ngol/google-maps-api-key";
  };

  # Nginx configuration
  services.nginx = {
    enable = true;
    
    # SSL configuration
    sslCiphers = "AES256+EECDH:AES256+EDH:!aNULL";
    
    # Recommended settings
    recommendedGzipSettings = true;
    recommendedOptimisation = true;
    recommendedProxySettings = true;
    recommendedTlsSettings = true;
  };

  # Security
  security = {
    # Sudo configuration
    sudo.wheelNeedsPassword = false;
    
    # SSL certificates
    acme = {
      acceptTerms = true;
      defaults.email = "admin@example.com";
    };
    
    # AppArmor
    apparmor.enable = true;
  };

  # Systemd services
  systemd = {
    # Better OOM handling
    oomd.enable = true;
    
    # Service hardening
    services = {
      # Harden NGOL services
      ngol-backend.serviceConfig = {
        # Additional hardening
        MemoryMax = "2G";
        CPUQuota = "80%";
      };
    };
  };

  # Logging
  services.journald.extraConfig = ''
    SystemMaxUse=1G
    SystemMaxFileSize=100M
  '';

  # Automatic updates
  system.autoUpgrade = {
    enable = true;
    dates = "02:00";
    flags = [
      "--update-input"
      "nixpkgs"
      "-L" # print build logs
    ];
    allowReboot = false;
  };

  # Garbage collection
  nix = {
    gc = {
      automatic = true;
      dates = "weekly";
      options = "--delete-older-than 30d";
    };
    
    # Binary cache
    settings = {
      substituters = [
        "https://cache.nixos.org"
        "https://nix-community.cachix.org"
      ];
      trusted-public-keys = [
        "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
        "nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs="
      ];
      
      # Enable flakes
      experimental-features = [ "nix-command" "flakes" ];
    };
  };

  # State version
  system.stateVersion = "24.05";
}
